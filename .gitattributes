# ===== Defaults =====
# Let git normalise line endings: store LF in the repo,
# convert to CRLF on checkout under Windows.
* text=auto

# ===== Ordinary text files =====
*.cs   text diff=csharp
*.md   text
*.py   text
*.csv  text
*.json text
*.txt  text
*.shader text

# ===== Unity serialized files (YAML) =====
# -text        = never let git convert line endings (Unity always writes LF, on Windows and Mac)
# merge=binary = never let git auto-merge these
#
# The merge=binary rule matters most.
# A .unity file is YAML full of cross-referenced fileIDs. If git merges it itself
# the result can be broken without being invalid - objects vanish or references dangle
# when Unity opens it. Marked binary, git forces you to pick a side, which is far easier to fix.
*.unity          -text merge=binary
*.prefab         -text merge=binary
*.asset          -text merge=binary
*.mat            -text merge=binary
*.meta           -text merge=binary
*.anim           -text merge=binary
*.controller     -text merge=binary
*.overrideController -text merge=binary
*.physicMaterial -text merge=binary
*.physicsMaterial2D -text merge=binary
*.playable       -text merge=binary
*.mask           -text merge=binary
*.brush          -text merge=binary
*.flare          -text merge=binary
*.fontsettings   -text merge=binary
*.guiskin        -text merge=binary
*.giparams       -text merge=binary
*.renderTexture  -text merge=binary
*.spriteatlas    -text merge=binary
*.terrainlayer   -text merge=binary
*.mixer          -text merge=binary
*.uss            -text merge=binary
*.uxml           -text merge=binary
*.inputactions   -text merge=binary

# ===== Genuine binary files =====
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.tga  binary
*.tif  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.dll  binary
*.pdf  binary
*.zip  binary
