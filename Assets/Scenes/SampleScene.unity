  config: {fileID: 993310865}
  fixedController: {fileID: 1501129891}
  adaptiveController: {fileID: 1501129893}
  dataLogger: {fileID: 1501129894}
  scenarioManager: {fileID: 1501129895}
  testCases:
  - name: "T1 \xB7 Single lane, 10 cars"
    description: 'Release 10 cars on lane A only, 1.5 s apart.

      Baseline check:
      cars queue in a neat line without overlapping, then discharge on green.'
    mode: 1
    suggestedDuration: 120
    rates: []
    schedules:
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 10
        spacing: 1.5
        randomDriver: 1
        driverType: 1
  - name: "T2 \xB7 All lanes equal"
    description: "All 7 lanes release 8 cars at once, 2 s apart (including the A2
      shared lane).\nFairness check: every signalised lane must get green; none may
      be starved.\nFree lane CA should show a wait near zero. Ax will NOT be zero
      \u2014 by design \u2014 for two reasons:\n(1) A2 stops at the red light in
      the same lane ahead of it, (2) Ax itself must yield while Bx is green."
    mode: 1
    suggestedDuration: 180
    rates: []
    schedules:
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: A2
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: Ax
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: B
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: Bx
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: CB
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: CA
      bursts:
      - atTime: 0
        carCount: 8
        spacing: 2
        randomDriver: 1
        driverType: 1
  - name: "T3 \xB7 Bx vs CB conflict"
    description: "Heavy load on Bx and CB at the same time, plus some traffic on
      A.\nKey check: Bx and CB must never be green together. Easy to see during a
      demo \u2014\nthe controller alternates between them."
    mode: 1
    suggestedDuration: 180
    rates: []
    schedules:
    - laneName: Bx
      bursts:
      - atTime: 0
        carCount: 12
        spacing: 1.5
        randomDriver: 1
        driverType: 1
    - laneName: CB
      bursts:
      - atTime: 0
        carCount: 12
        spacing: 1.5
        randomDriver: 1
        driverType: 1
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 6
        spacing: 3
        randomDriver: 1
        driverType: 1
  - name: "T4 \xB7 Starvation test"
    description: "A and B run continuously with 40 cars each, while CB gets a single
      car at t = 5 s.\nQuestion: does that one CB car ever get green, and how long
      does it wait?\nThis is the test that proves anti-starvation works \u2014 examiners
      like to ask about it."
    mode: 1
    suggestedDuration: 180
    rates: []
    schedules:
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 40
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: B
      bursts:
      - atTime: 0
        carCount: 40
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: CB
      bursts:
      - atTime: 5
        carCount: 1
        spacing: 1
        randomDriver: 1
        driverType: 1
  - name: "T5 \xB7 Campus event in/out"
    description: "Heavy inbound first (Ax, Bx), then at t = 90 s everyone leaves
      at once (CB, CA).\nModels a graduation-day surge \u2014 checks that the controller
      adapts to a reversal in direction."
    mode: 1
    suggestedDuration: 300
    rates: []
    schedules:
    - laneName: Ax
      bursts:
      - atTime: 0
        carCount: 20
        spacing: 1.2
        randomDriver: 1
        driverType: 1
    - laneName: Bx
      bursts:
      - atTime: 0
        carCount: 20
        spacing: 1.2
        randomDriver: 1
        driverType: 1
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 10
        spacing: 4
        randomDriver: 1
        driverType: 1
    - laneName: B
      bursts:
      - atTime: 0
        carCount: 10
        spacing: 4
        randomDriver: 1
        driverType: 1
    - laneName: CB
      bursts:
      - atTime: 90
        carCount: 20
        spacing: 1.2
        randomDriver: 1
        driverType: 1
    - laneName: CA
      bursts:
      - atTime: 90
        carCount: 20
        spacing: 1.2
        randomDriver: 1
        driverType: 1
  - name: "T6 \xB7 Unsignalised lanes (Ax, CA)"
    description: "Only Ax and CA release vehicles. No A2 present to block anything.\nCA
      is genuinely free \u2014 its wait must stay near zero, otherwise stopLineTarget
      is misconfigured.\nAx is no longer truly free (it yields while Bx is green),
      which makes this the sharpest\nFixed-vs-Adaptive comparison in the set:\n  
      \u2022 Fixed \u2192 Bx gets green every cycle even with zero Bx traffic, so
      Ax stops for nothing.\n   \u2022 Adaptive \u2192 no demand on Bx means no green,
      so Ax barely waits at all."
    mode: 1
    suggestedDuration: 120
    rates: []
    schedules:
    - laneName: Ax
      bursts:
      - atTime: 0
        carCount: 15
        spacing: 2
        randomDriver: 1
        driverType: 1
    - laneName: CA
      bursts:
      - atTime: 0
        carCount: 15
        spacing: 2
        randomDriver: 1
        driverType: 1
  - name: "T7 \xB7 Driver profiles"
    description: 'Lane A releases 6 aggressive drivers, then 6 cautious drivers at
      t = 40 s.

      Compares braking distance, reaction time and amber-running
      between profiles.'
    mode: 1
    suggestedDuration: 150
    rates: []
    schedules:
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 6
        spacing: 2.5
        randomDriver: 0
        driverType: 0
      - atTime: 40
        carCount: 6
        spacing: 2.5
        randomDriver: 0
        driverType: 2
    - laneName: B
      bursts:
      - atTime: 0
        carCount: 6
        spacing: 5
        randomDriver: 1
        driverType: 1
  - name: "T13 \xB7 Shared Lane Blocking Demo"
    description: "Direct demonstration of the shared-lane mechanism: A2 (straight,
      outer lane) and\nAx (turning into campus) occupy the same physical lane.\nA2
      waits at the red light like any straight vehicle \u2014 and every Ax car behind
      it is trapped,\neven though no signal applies to Ax at all.\nWhen Bx turns
      green, Ax must stop at its own line too, so the Ax queue blocks A2 in return.\nWatch
      the Ax+A2 row in the HUD (one shared ROI = what a real detector sees)."
    mode: 1
    suggestedDuration: 300
    rates: []
    schedules:
    - laneName: A2
      bursts:
      - atTime: 0
        carCount: 30
        spacing: 4
        randomDriver: 1
        driverType: 1
    - laneName: Ax
      bursts:
      - atTime: 2
        carCount: 40
        spacing: 3
        randomDriver: 1
        driverType: 1
    - laneName: B
      bursts:
      - atTime: 0
        carCount: 15
        spacing: 5
        randomDriver: 1
        driverType: 1
  - name: "T8 \xB7 MorningPeak"
    description: "\u0E04\u0E19\u0E40\u0E02\u0E49\u0E32\u0E21\u0E2B\u0E32\u0E25\u0E31\u0E22\u0E40\u0E22\u0E2D\u0E30
      \u2014 A/Ax/B/Bx \u0E40\u0E1B\u0E47\u0E19\u0E04\u0E48\u0E32\u0E27\u0E31\u0E14\u0E08\u0E23\u0E34\u0E07\u0E08\u0E32\u0E01
      Itim (13 \u0E01.\u0E04. 08:40-09:05, \u0E1B\u0E23\u0E31\u0E1A\u0E41\u0E01\u0E49\u0E15\u0E31\u0E27\u0E40\u0E25\u0E02\u0E23\u0E2D\u0E1A
      24 \u0E2A.\u0E04. \u0E2B\u0E25\u0E31\u0E07\u0E23\u0E31\u0E19 detector \u0E04\u0E23\u0E1A
      8 \u0E04\u0E25\u0E34\u0E1B)\nCB/CA = \u0E1B\u0E34\u0E14 \u2014 \u0E41\u0E01\u0E49\u0E41\u0E25\u0E49\u0E27:
      \u0E40\u0E25\u0E19 C \u0E02\u0E32\u0E2D\u0E2D\u0E01\u0E1B\u0E34\u0E14\u0E41\u0E04\u0E48
      08:30-09:00 (~15-30 \u0E19\u0E32\u0E17\u0E35) \u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E17\u0E31\u0E49\u0E07\u0E40\u0E0A\u0E49\u0E32
      \u0E41\u0E15\u0E48\u0E1E\u0E2D\u0E14\u0E35\u0E15\u0E23\u0E07\u0E01\u0E31\u0E1A\u0E0A\u0E48\u0E27\u0E07
      peak \u0E19\u0E35\u0E49\u0E40\u0E1B\u0E4A\u0E30 (08:15-09:00) \u0E08\u0E36\u0E07\u0E22\u0E31\u0E07\u0E43\u0E0A\u0E49
      CB\u2248CA\u22480 \u0E44\u0E14\u0E49\n(\u0E2A\u0E38\u0E48\u0E21\u0E41\u0E1A\u0E1A
      Poisson \u2014 \u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19 seed \u0E41\u0E25\u0E49\u0E27\u0E1C\u0E25\u0E08\u0E30\u0E15\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19
      \u0E43\u0E0A\u0E49\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E2A\u0E16\u0E34\u0E15\u0E34
      \u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E14\u0E42\u0E21)"
    mode: 0
    suggestedDuration: 300
    rates:
    - laneName: A
      meanInterval: 19.87315
    - laneName: A2
      meanInterval: 348.14813
    - laneName: Ax
      meanInterval: 5.1
    - laneName: B
      meanInterval: 9
    - laneName: Bx
      meanInterval: 9.6
    - laneName: CB
      meanInterval: 999999
    - laneName: CA
      meanInterval: 999999
