  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimulationControlPanel
  config: {fileID: 993310865}
  fixedController: {fileID: 1501129891}
  adaptiveController: {fileID: 1501129893}
  dataLogger: {fileID: 1501129894}
  scenarioManager: {fileID: 1501129895}
  testCases:
  - name: "T1 \xB7 \u0E40\u0E25\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27 10 \u0E04\u0E31\u0E19"
    description: "\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E23\u0E16\u0E40\u0E09\u0E1E\u0E32\u0E30\u0E40\u0E25\u0E19
      A 10 \u0E04\u0E31\u0E19 \u0E2B\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19 1.5 \u0E27\u0E34\n\u0E15\u0E23\u0E27\u0E08\u0E1E\u0E37\u0E49\u0E19\u0E10\u0E32\u0E19:
      \u0E23\u0E16\u0E08\u0E2D\u0E14\u0E23\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E41\u0E16\u0E27\u0E2A\u0E27\u0E22
      \u0E46 \u0E44\u0E21\u0E48\u0E0B\u0E49\u0E2D\u0E19\u0E01\u0E31\u0E19 \u0E41\u0E25\u0E49\u0E27\u0E23\u0E30\u0E1A\u0E32\u0E22\u0E2D\u0E2D\u0E01\u0E15\u0E2D\u0E19\u0E44\u0E1F\u0E40\u0E02\u0E35\u0E22\u0E27"
    mode: 1
    suggestedDuration: 120
    rates: []
    schedules:
    - laneName: A
      bursts:
      - atTime: 0
        carCount: 10
        spacing: 1.5
        randomDriver: 1
        driverType: 1
  - name: "T2 \xB7 \u0E17\u0E38\u0E01\u0E40\u0E25\u0E19\u0E40\u0E17\u0E48\u0E32\u0E01\u0E31\u0E19"
    description: "\u0E17\u0E31\u0E49\u0E07 7 \u0E40\u0E25\u0E19\u0E1B\u0E25\u0E48\u0E2D\u0E22
      8 \u0E04\u0E31\u0E19\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E01\u0E31\u0E19 \u0E2B\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19
      2 \u0E27\u0E34 (\u0E23\u0E27\u0E21 A2 \u0E40\u0E25\u0E19\u0E41\u0E0A\u0E23\u0E4C\u0E14\u0E49\u0E27\u0E22)\n\u0E15\u0E23\u0E27\u0E08\u0E04\u0E27\u0E32\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E18\u0E23\u0E23\u0E21:
      \u0E17\u0E38\u0E01\u0E40\u0E25\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E44\u0E14\u0E49\u0E44\u0E1F\u0E40\u0E02\u0E35\u0E22\u0E27
      \u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E25\u0E19\u0E44\u0E2B\u0E19\u0E16\u0E39\u0E01\u0E17\u0E34\u0E49\u0E07\n\u0E41\u0E25\u0E30\u0E40\u0E25\u0E19\u0E1F\u0E23\u0E35
      CA \u0E15\u0E49\u0E2D\u0E07\u0E21\u0E35\u0E40\u0E27\u0E25\u0E32\u0E23\u0E2D\u0E43\u0E01\u0E25\u0E49
      0 \u2014 \u0E2A\u0E48\u0E27\u0E19 Ax \u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48
      0 \u0E41\u0E25\u0E49\u0E27 (\u0E42\u0E14\u0E19\u0E15\u0E31\u0E49\u0E07\u0E43\u0E08)
      \u0E14\u0E49\u0E27\u0E22 2 \u0E40\u0E2B\u0E15\u0E38:\n(1) A2 \u0E08\u0E2D\u0E14\u0E23\u0E2D\u0E44\u0E1F\u0E41\u0E14\u0E07\u0E1A\u0E25\u0E47\u0E2D\u0E01\u0E2D\u0E22\u0E39\u0E48\u0E02\u0E49\u0E32\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E43\u0E19\u0E40\u0E25\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19
      (2) Ax \u0E40\u0E2D\u0E07\u0E01\u0E47\u0E15\u0E49\u0E2D\u0E07\u0E2B\u0E22\u0E38\u0E14\u0E15\u0E2D\u0E19
      Bx \u0E40\u0E02\u0E35\u0E22\u0E27\n\u0E14\u0E39 T13 \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E01\u0E23\u0E13\u0E35\u0E17\u0E35\u0E48\u0E0A\u0E31\u0E14\u0E01\u0E27\u0E48\u0E32\u0E19\u0E35\u0E49"
