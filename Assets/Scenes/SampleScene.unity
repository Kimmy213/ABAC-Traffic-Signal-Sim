  m_Script: {fileID: 11500000, guid: 1e707e486b878bc4892acd78457bdae0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntersectionConfig
  lanes:
  - laneName: A
    isSignalized: 1
    trafficLight: {fileID: 501255444}
    roi: {fileID: 1307751670}
    spawner: {fileID: 239361990}
    movementDescription: "\u0E16\u0E19\u0E19\u0E1A\u0E32\u0E07\u0E19\u0E32-\u0E15\u0E23\u0E32\u0E14
      \u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E44\u0E1B\u0E15\u0E30\u0E27\u0E31\u0E19\u0E2D\u0E2D\u0E01
      (+X) \u0E27\u0E34\u0E48\u0E07\u0E15\u0E23\u0E07\u0E1C\u0E48\u0E32\u0E19\u0E41\u0E22\u0E01"
  - laneName: Ax
    isSignalized: 0
    trafficLight: {fileID: 0}
    roi: {fileID: 760501276}
    spawner: {fileID: 631168425}
    movementDescription: "\u0E41\u0E22\u0E01\u0E08\u0E32\u0E01 A \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E0B\u0E49\u0E32\u0E22\u0E40\u0E02\u0E49\u0E32
      ABAC \u2014 \u0E1F\u0E23\u0E35 \u0E44\u0E21\u0E48\u0E15\u0E31\u0E14\u0E01\u0E23\u0E30\u0E41\u0E2A\u0E43\u0E04\u0E23
      (ABAC \u0E2D\u0E22\u0E39\u0E48\u0E17\u0E32\u0E07\u0E0B\u0E49\u0E32\u0E22\u0E02\u0E2D\u0E07
      A)"
  - laneName: B
    isSignalized: 1
    trafficLight: {fileID: 1173222523}
    roi: {fileID: 1362598440}
    spawner: {fileID: 1976685764}
    movementDescription: "\u0E16\u0E19\u0E19\u0E1A\u0E32\u0E07\u0E19\u0E32-\u0E15\u0E23\u0E32\u0E14
      \u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E44\u0E1B\u0E15\u0E30\u0E27\u0E31\u0E19\u0E15\u0E01
      (-X) \u0E27\u0E34\u0E48\u0E07\u0E15\u0E23\u0E07\u0E1C\u0E48\u0E32\u0E19\u0E41\u0E22\u0E01"
  - laneName: Bx
    isSignalized: 1
    trafficLight: {fileID: 1427986944}
    roi: {fileID: 1751028665}
    spawner: {fileID: 1990622527}
    movementDescription: "\u0E41\u0E22\u0E01\u0E08\u0E32\u0E01 B \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E02\u0E27\u0E32\u0E40\u0E02\u0E49\u0E32
      ABAC \u2014 \u0E15\u0E31\u0E14\u0E01\u0E23\u0E30\u0E41\u0E2A A (ABAC \u0E2D\u0E22\u0E39\u0E48\u0E17\u0E32\u0E07\u0E02\u0E27\u0E32\u0E02\u0E2D\u0E07
      B)"
  - laneName: CB
    isSignalized: 1
    trafficLight: {fileID: 686202311}
    roi: {fileID: 1622409340}
    spawner: {fileID: 1369458988}
    movementDescription: "\u0E2D\u0E2D\u0E01\u0E08\u0E32\u0E01 ABAC \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E02\u0E27\u0E32\u0E44\u0E1B\u0E17\u0E32\u0E07\u0E15\u0E30\u0E27\u0E31\u0E19\u0E15\u0E01
      merge \u0E40\u0E02\u0E49\u0E32\u0E40\u0E25\u0E19 B \u2014 \u0E15\u0E49\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E21\u0E40\u0E25\u0E19
      A \u0E01\u0E48\u0E2D\u0E19"
  - laneName: CA
    isSignalized: 0
    trafficLight: {fileID: 0}
    roi: {fileID: 2061120287}
    spawner: {fileID: 1977416009}
    movementDescription: "\u0E2D\u0E2D\u0E01\u0E08\u0E32\u0E01 ABAC \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E0B\u0E49\u0E32\u0E22\u0E44\u0E1B\u0E17\u0E32\u0E07\u0E15\u0E30\u0E27\u0E31\u0E19\u0E2D\u0E2D\u0E01
      merge \u0E40\u0E02\u0E49\u0E32\u0E40\u0E25\u0E19 A \u2014 \u0E1F\u0E23\u0E35
      \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E21\u0E40\u0E25\u0E19\u0E43\u0E04\u0E23"
  conflicts:
  - laneA: A
    laneB: Bx
    reason: "Bx \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E02\u0E27\u0E32\u0E40\u0E02\u0E49\u0E32
      ABAC \u0E15\u0E49\u0E2D\u0E07\u0E15\u0E31\u0E14\u0E1C\u0E48\u0E32\u0E19\u0E01\u0E23\u0E30\u0E41\u0E2A\u0E23\u0E16\u0E15\u0E23\u0E07\u0E02\u0E2D\u0E07\u0E40\u0E25\u0E19
      A"
  - laneA: A
    laneB: CB
    reason: "CB \u0E15\u0E49\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E21\u0E0A\u0E48\u0E2D\u0E07\u0E08\u0E23\u0E32\u0E08\u0E23\u0E02\u0E2D\u0E07\u0E40\u0E25\u0E19
      A \u0E01\u0E48\u0E2D\u0E19\u0E44\u0E1B merge \u0E40\u0E25\u0E19 B"
  - laneA: B
    laneB: CB
    reason: "CB merge \u0E40\u0E02\u0E49\u0E32\u0E0A\u0E48\u0E2D\u0E07\u0E08\u0E23\u0E32\u0E08\u0E23\u0E17\u0E35\u0E48
      B \u0E01\u0E33\u0E25\u0E31\u0E07\u0E27\u0E34\u0E48\u0E07\u0E1C\u0E48\u0E32\u0E19\u0E1E\u0E2D\u0E14\u0E35"
  - laneA: Bx
    laneB: CB
    reason: "\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E15\u0E31\u0E14\u0E01\u0E31\u0E19\u0E01\u0E25\u0E32\u0E07\u0E41\u0E22\u0E01
      (\u0E15\u0E32\u0E21\u0E17\u0E35\u0E48\u0E23\u0E30\u0E1A\u0E38\u0E43\u0E19 scope)"
