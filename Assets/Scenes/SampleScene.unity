  m_Script: {fileID: 11500000, guid: 1e707e486b878bc4892acd78457bdae0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntersectionConfig
  lanes:
  - laneName: A
    isSignalized: 1
    trafficLight: {fileID: 501255444}
    roi: {fileID: 1307751670}
    spawner: {fileID: 239361990}
    movementDescription: "\u0E16\u0E19\u0E19\u0E1A\u0E32\u0E07\u0E19\u0E32-\u0E15\u0E23\u0E32\u0E14
      \u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E44\u0E1B\u0E15\u0E30\u0E27\u0E31\u0E19\u0E2D\u0E2D\u0E01
      (+X) \u0E27\u0E34\u0E48\u0E07\u0E15\u0E23\u0E07\u0E1C\u0E48\u0E32\u0E19\u0E41\u0E22\u0E01
      \u2014 \u0E40\u0E25\u0E19\u0E43\u0E19"
  - laneName: A2
    isSignalized: 1
    trafficLight: {fileID: 501255444}
    roi: {fileID: 760501276}
    spawner: {fileID: 943301583}
    movementDescription: "\u0E23\u0E16\u0E15\u0E23\u0E07\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49\u0E40\u0E25\u0E19\u0E19\u0E2D\u0E01\u0E23\u0E48\u0E27\u0E21\u0E01\u0E31\u0E1A
      Ax (shared lane) \u2014 \u0E43\u0E0A\u0E49\u0E44\u0E1F\u0E14\u0E27\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E1A
      A \u0E40\u0E1B\u0E4A\u0E30 \u0E46 \u0E41\u0E25\u0E30 ROI \u0E15\u0E31\u0E27\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E1A
      Ax \u0E40\u0E1B\u0E4A\u0E30 \u0E46 (\u0E2D\u0E49\u0E32\u0E07\u0E16\u0E36\u0E07
      component \u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19\u0E17\u0E31\u0E49\u0E07\u0E04\u0E39\u0E48
      \u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E41\u0E04\u0E48\u0E15\u0E31\u0E49\u0E07\u0E04\u0E48\u0E32\u0E43\u0E2B\u0E49\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19)
      \u0E08\u0E36\u0E07\u0E40\u0E02\u0E35\u0E22\u0E27/\u0E41\u0E14\u0E07\u0E1E\u0E23\u0E49\u0E2D\u0E21
      A \u0E40\u0E2A\u0E21\u0E2D \u0E41\u0E25\u0E30\u0E16\u0E39\u0E01\u0E19\u0E31\u0E1A\u0E23\u0E27\u0E21\u0E01\u0E31\u0E1A
      Ax \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E17\u0E35\u0E48 detector \u0E08\u0E23\u0E34\u0E07\u0E40\u0E2B\u0E47\u0E19
      \u2014 \u0E2A\u0E31\u0E14\u0E2A\u0E48\u0E27\u0E19\u0E23\u0E16\u0E15\u0E23\u0E07\u0E40\u0E02\u0E49\u0E32\u0E40\u0E25\u0E19\u0E19\u0E2D\u0E01
      5.4% \u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E19\u0E31\u0E1A\u0E15\u0E23\u0E07
      (SP1_HANDOFF_v2 \xA75 \u2014 \u0E41\u0E17\u0E19\u0E17\u0E35\u0E48\u0E04\u0E48\u0E32
      back-calculate 18% \u0E40\u0E14\u0E34\u0E21\u0E41\u0E25\u0E49\u0E27)"
  - laneName: Ax
    isSignalized: 0
    trafficLight: {fileID: 0}
    roi: {fileID: 760501276}
    spawner: {fileID: 631168425}
    movementDescription: "\u0E41\u0E22\u0E01\u0E08\u0E32\u0E01 A \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E0B\u0E49\u0E32\u0E22\u0E40\u0E02\u0E49\u0E32
      ABAC (ABAC \u0E2D\u0E22\u0E39\u0E48\u0E17\u0E32\u0E07\u0E0B\u0E49\u0E32\u0E22\u0E02\u0E2D\u0E07
      A) \u2014 \u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E1F\u0E2A/\u0E40\u0E27\u0E25\u0E32\u0E40\u0E02\u0E35\u0E22\u0E27\u0E02\u0E2D\u0E07\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07
      \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E25\u0E19\u0E1F\u0E23\u0E35
      100%: (1) \u0E27\u0E34\u0E48\u0E07\u0E40\u0E25\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E1A
      A2 \u0E08\u0E36\u0E07\u0E16\u0E39\u0E01 A2 \u0E17\u0E35\u0E48\u0E08\u0E2D\u0E14\u0E23\u0E2D\u0E44\u0E1F\u0E41\u0E14\u0E07\u0E1A\u0E25\u0E47\u0E2D\u0E01
      (2) \u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E40\u0E02\u0E49\u0E32\u0E21\u0E2D\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E15\u0E2D\u0E19
      Bx \u0E40\u0E02\u0E35\u0E22\u0E27 \u0E40\u0E1E\u0E23\u0E32\u0E30 Bx \u0E01\u0E47\u0E40\u0E25\u0E35\u0E49\u0E22\u0E27\u0E40\u0E02\u0E49\u0E32\u0E21\u0E2D\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19
      \u2014 \u0E17\u0E33\u0E1C\u0E48\u0E32\u0E19 CarSpawner.lightIsInverted \u0E1C\u0E39\u0E01\u0E01\u0E31\u0E1A\u0E44\u0E1F
      Bx \u0E41\u0E1A\u0E1A\u0E01\u0E25\u0E31\u0E1A\u0E14\u0E49\u0E32\u0E19 \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19
